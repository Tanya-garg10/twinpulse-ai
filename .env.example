# FEATHERLESS AI CONFIGURATION
# Get your API key from https://featherless.ai (Dashboard → API Keys).
# Featherless provides an OpenAI-compatible API for open-weight models.
VITE_FEATHERLESS_API_KEY="YOUR_FEATHERLESS_API_KEY"
VITE_FEATHERLESS_BASE_URL="https://api.featherless.ai/v1"
VITE_FEATHERLESS_MODEL="Qwen/Qwen2.5-7B-Instruct"

# Server / CLI variables (optional)
FEATHERLESS_API_KEY="YOUR_FEATHERLESS_API_KEY"
FEATHERLESS_BASE_URL="https://api.featherless.ai/v1"
FEATHERLESS_MODEL="Qwen/Qwen2.5-7B-Instruct"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

